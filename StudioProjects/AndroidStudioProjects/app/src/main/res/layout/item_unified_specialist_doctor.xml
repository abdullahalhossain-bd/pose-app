<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:orientation="vertical">
    <com.google.android.material.card.MaterialCardView

        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="6dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:background="@drawable/rounded_background">

            <!-- Doctor Image -->
            <ImageView
                android:id="@+id/unified_specialist_doctor_image"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:adjustViewBounds="true"
                android:scaleType="centerCrop"
                android:src="@drawable/cardiologist"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Name -->
            <TextView
                android:id="@+id/unified_specialist_doctor_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="কার্ডিওলজিস্ট ডাঃ জন ডো"
                android:textSize="18sp"
                app:layout_constraintStart_toEndOf="@id/unified_specialist_doctor_image"
                app:layout_constraintTop_toTopOf="@id/unified_specialist_doctor_image"
                app:layout_constraintEnd_toEndOf="parent" android:fontFamily="@font/bnlatxf" />

            <!-- Qualifications -->
            <TextView
                android:id="@+id/unified_specialist_doctor_qualifications"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="এমবিবিএস, এফসিপিএস (কার্ডিওলজি)"
                android:textSize="14sp"
                app:layout_constraintStart_toEndOf="@id/unified_specialist_doctor_image"
                app:layout_constraintTop_toBottomOf="@id/unified_specialist_doctor_name"
                app:layout_constraintEnd_toEndOf="parent" android:fontFamily="@font/bnlatxf" />

            <!-- Address -->
            <TextView
                android:id="@+id/unified_specialist_doctor_address"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="ন্যাশনাল হার্ট ফাউন্ডেশন হাসপাতাল, ঢাকা"
                android:textSize="14sp"
                app:layout_constraintStart_toEndOf="@id/unified_specialist_doctor_image"
                app:layout_constraintTop_toBottomOf="@id/unified_specialist_doctor_qualifications"
                app:layout_constraintEnd_toEndOf="parent" android:fontFamily="@font/bnlatxf" />

            <!-- Details -->
            <TextView
                android:id="@+id/unified_specialist_doctor_details"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="কার্ডিওলজি বিশেষজ্ঞ"
                android:textSize="17sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/unified_specialist_doctor_image"
                app:layout_constraintEnd_toEndOf="parent" android:fontFamily="@font/bnlatxf" />

            <!-- Buttons Row -->
            <LinearLayout
                android:id="@+id/buttons_row"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="15dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/unified_specialist_doctor_details">

                <Button
                    android:id="@+id/call_button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="সিরিয়াল নিন"
                    android:textColor="@android:color/white"
                    android:backgroundTint="@color/bar" android:fontFamily="@font/bnlatxf" />

                <Button
                    android:id="@+id/details_button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="বিস্তারিত জানুন"
                    android:textColor="@android:color/white"
                    android:backgroundTint="@color/bar" android:fontFamily="@font/bnlatxf" />
            </LinearLayout>

            <!-- Bottom Row -->
            <LinearLayout
                android:id="@+id/bottom_row"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="4dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/buttons_row"
                app:layout_constraintBottom_toBottomOf="parent"
                android:gravity="center_vertical">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_edit"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:text="✎  সম্পাদনা করুন"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/btn_edit_bg" android:fontFamily="@font/bnlatxf" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_delete"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:text="🗑  মুছে দিন"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/btn_delete_bg" android:fontFamily="@font/bnlatxf" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
