<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:background="#fff">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <androidx.constraintlayout.widget.ConstraintLayout
            xmlns:tools="http://schemas.android.com/tools"
            android:layout_width="match_parent"
            android:layout_marginBottom="30dp"
            android:layout_height="wrap_content"
            android:background="#fff">

            <!-- Top Background Image -->
            <ImageView
                android:id="@+id/topBackgroundImage"
                android:layout_width="0dp"
                android:layout_height="300dp"
                android:src="@drawable/registation"
                android:scaleType="centerCrop"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Welcome Text -->
            <TextView
                android:id="@+id/welcomeText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textSize="20sp"
                android:textStyle="bold"
                android:text="ক্লিনিক এর বিস্তারিত তথ্য\nএখানে যুক্ত করুন ।"
                android:fontFamily="@font/bnlatx"
                android:textColor="#fff"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="16dp" />

            <!-- Registration Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/registrationCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="20dp"
                app:cardElevation="10dp"
                android:layout_marginBottom="50dp"
                app:layout_constraintTop_toBottomOf="@id/welcomeText"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="32dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Clinic Image Upload + Clinic Name -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center|start">

                        <de.hdodenhof.circleimageview.CircleImageView
                            android:id="@+id/clinicImage"
                            android:layout_width="100dp"
                            android:layout_height="120dp"
                            android:src="@drawable/ic_clinic"
                            android:layout_margin="8dp"
                            android:scaleType="centerCrop"
                            app:civ_border_color="@color/black"
                            app:civ_border_width="2dp" />

                        <!-- name -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/clinicNameInputLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="ক্লিনিক এর নাম দিন"
                            android:layout_margin="5dp">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/clinicName"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/bnlatxf" />
                        </com.google.android.material.textfield.TextInputLayout>

                    </LinearLayout>

                    <!-- address -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/addressInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="5dp"
                        android:hint="ক্লিনিক এর ঠিকানা দিন">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/clinicAddress"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/bnlatxf" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- place_name -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/placeNameInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="5dp"
                        android:hint="স্থানের নাম দিন">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/placeName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/bnlatxf" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- phone_number -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/phoneInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="5dp"
                        android:hint="ক্লিনিক এর ফোন নম্বর দিন">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/clinicPhone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/bnlatxf"
                            android:inputType="phone" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- complaint_phone_number -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/complaintPhoneInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="5dp"
                        android:hint="অভিযোগ ফোন নম্বর দিন">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/complaintPhone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/bnlatxf"
                            android:inputType="phone" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- email -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/emailInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="5dp"
                        android:hint="ইমেইল দিন">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/clinicEmail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/bnlatxf"
                            android:inputType="textEmailAddress" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- establish_date -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/establishmentDateInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="5dp"
                        android:hint="প্রতিষ্ঠার তারিখ (YYYY-MM-DD)">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/establishmentDate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/bnlatxf"
                            android:inputType="text" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- founder_name -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/founderNameInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="5dp"
                        android:hint="প্রতিষ্ঠাতার নাম">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/founderName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/bnlatxf" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- transport_info -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/transportInfoInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="5dp"
                        android:hint="পরিবহন তথ্য দিন">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/transportInfo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/bnlatxf" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- operating_hours -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/operatingHoursInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="5dp"
                        android:hint="কার্যকর সময় (যেমন: 9:00 AM - 10:00 PM)">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/operatingHours"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/bnlatxf" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- union -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/unionInputLayout"
                        style="@style/Widget.MaterialComponents.TextInputLayout.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="80dp"
                        android:layout_margin="5dp"
                        android:hint="ইউনিয়ন নির্বাচন করুন">

                        <AutoCompleteTextView
                            android:id="@+id/unionDropdown"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/bnlatxf"
                            android:inputType="none" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- ===== SERVICES SECTION ===== -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="সেবা যুক্ত করুন"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#1eb1b1"
                        android:fontFamily="@font/bnlatxf"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="8dp" />

                    <!-- Dynamic services will be added here programmatically -->
                    <LinearLayout
                        android:id="@+id/servicesContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- First service row (default) -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <!-- test_name -->
                            <com.google.android.material.textfield.TextInputLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="2"
                                android:layout_margin="5dp"
                                android:hint="সেবার নাম">
                                <com.google.android.material.textfield.TextInputEditText
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/bnlatxf" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <!-- fee -->
                            <com.google.android.material.textfield.TextInputLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_margin="5dp"
                                android:hint="ফি (৳)">
                                <com.google.android.material.textfield.TextInputEditText
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/bnlatxf"
                                    android:inputType="numberDecimal" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <!-- Remove button (hidden for first row) -->
                            <ImageButton
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:src="@drawable/ic_menu_remove"
                                android:background="?android:attr/selectableItemBackgroundBorderless"
                                app:tint="#e53935"

                                android:visibility="gone" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Add Service Button -->
                    <TextView
                        android:id="@+id/addServiceButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+ আরও সেবা যুক্ত করুন"
                        android:textSize="14sp"
                        android:textColor="#1eb1b1"
                        android:textStyle="bold"
                        android:fontFamily="@font/bnlatxf"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="8dp"
                        android:paddingHorizontal="5dp" />

                    <!-- Submit Button -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/submitButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="10dp"
                        app:cardBackgroundColor="#1eb1b1"
                        app:cardCornerRadius="20dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="16dp"
                            android:text="যুক্ত করুন"
                            android:textColor="@android:color/white"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/bnlatxf" />
                    </androidx.cardview.widget.CardView>

                    <!-- Delete Button (Edit Mode Only) -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/deleteButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp"
                        app:cardBackgroundColor="#e53935"
                        app:cardCornerRadius="20dp"
                        android:visibility="gone">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="16dp"
                            android:text="ডিলিট করুন"
                            android:textColor="@android:color/white"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/bnlatxf" />
                    </androidx.cardview.widget.CardView>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <ProgressBar
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/progress"
                android:visibility="gone"
                tools:ignore="MissingConstraints" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>
</ScrollView>
