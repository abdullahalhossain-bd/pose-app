<?xml version="1.0" encoding="utf-8"?>
<!--
    Phase 3 — Developer info dialog.
    Styled to match the existing app UI: CardView with rounded corners, bnlatxf font,
    same color palette as fragment_profile.xml.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@android:color/white">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="15dp"
        app:cardElevation="10dp"
        app:cardMaxElevation="15dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Header icon -->
            <ImageView
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_gravity="center"
                android:layout_marginBottom="8dp"
                android:src="@drawable/baseline_engineering_24"
                android:contentDescription="ডেভেলপার" />

            <!-- Title -->
            <TextView
                android:id="@+id/developerTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:fontFamily="@font/bnlatxf"
                android:gravity="center"
                android:text="ডেভেলপার সম্পর্কে"
                android:textColor="#000000"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- Body text — populated from R.string.about_developer -->
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true">

                <TextView
                    android:id="@+id/developerBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/bnlatxf"
                    android:gravity="start"
                    android:lineSpacingExtra="4dp"
                    android:padding="8dp"
                    android:textColor="#333333"
                    android:textSize="15sp" />
            </ScrollView>

            <!-- Close button -->
            <androidx.cardview.widget.CardView
                android:id="@+id/developerCloseButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="#E53935"
                app:cardCornerRadius="12dp"
                app:cardElevation="5dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fontFamily="@font/bnlatxf"
                    android:gravity="center"
                    android:text="ঠিক আছে"
                    android:textColor="@android:color/white"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>
