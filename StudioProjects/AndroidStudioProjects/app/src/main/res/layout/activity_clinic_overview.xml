<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:gravity="center_vertical"
        android:id="@+id/title"
        android:background="#1eb1b1"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:paddingStart="6dp"
        android:paddingEnd="16dp"
        android:elevation="4dp">

        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:ellipsize="end"
            android:id="@+id/clinic_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="প্রাণিসম্পদ ভেটেরিনারি হাসপাতাল"
            android:maxLines="1"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"
            android:fontFamily="@font/kalpurush"
            android:layout_marginStart="10dp"/>

        <ImageButton
            android:id="@+id/backIcon"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/back"
            android:tint="@android:color/white"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"/>
    </RelativeLayout>

    <LinearLayout
        android:orientation="vertical"
        android:padding="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@android:color/black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="প্রতিষ্ঠার তারিখ:"
                android:fontFamily="@font/kalpurush"/>

            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@android:color/black"
                android:id="@+id/establishment_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1990"
                android:fontFamily="@font/kalpurush"/>
        </LinearLayout>

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp">

            <TextView
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="প্রতিষ্ঠাতার নাম: "
                android:fontFamily="@font/kalpurush"/>

            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_secondary"
                android:id="@+id/founder_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/kalpurush"/>
        </LinearLayout>

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp">

            <TextView
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ইউনিয়ন: "
                android:fontFamily="@font/kalpurush"/>

            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_secondary"
                android:id="@+id/union_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/kalpurush"/>
        </LinearLayout>

        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="ঠিকানা"
            android:fontFamily="@font/kalpurush"/>

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <com.google.android.material.card.MaterialCardView
                android:background="@color/white"
                android:layout_width="64dp"
                android:layout_height="64dp">

                <ImageView
                    android:id="@+id/clinic_image"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:scaleType="centerCrop"
                    android:contentDescription="Building Image"
                    android:layout_marginEnd="8dp"/>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp">

                <TextView
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/black"
                    android:id="@+id/address"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="123 Health St."
                    android:fontFamily="@font/kalpurush"/>

                <TextView
                    android:textSize="12sp"
                    android:textColor="@android:color/darker_gray"
                    android:id="@+id/transport_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Near City Park, accessible by rickshaw"
                    android:fontFamily="@font/kalpurush"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <TextView
                android:textSize="14sp"
                android:textColor="@android:color/black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="কার্যকালীন সময়: "
                android:fontFamily="@font/kalpurush"/>

            <TextView
                android:textSize="14sp"
                android:textColor="@android:color/black"
                android:id="@+id/time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="9 AM - 5 PM"
                android:fontFamily="@font/kalpurush"/>
        </LinearLayout>

        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="টেস্ট এবং ফি"
            android:fontFamily="@font/kalpurush"/>

        <Button
            android:textColor="@android:color/white"
            android:id="@+id/test"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="টেস্ট এবং ফি দেখুন"
            android:textAllCaps="false"
            android:fontFamily="@font/kalpurush"
            android:backgroundTint="#1eb1b1"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp"
            app:cornerRadius="8dp"/>

        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="যোগাযোগের তথ্য"
            android:fontFamily="@font/kalpurush"/>

        <TextView
            android:textSize="14sp"
            android:textColor="@android:color/black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="ফোন"
            android:fontFamily="@font/kalpurush"/>

        <TextView
            android:textSize="14sp"
            android:textColor="@android:color/darker_gray"
            android:id="@+id/phone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+1 234 567 890"
            android:fontFamily="@font/kalpurush"/>

        <TextView
            android:textSize="14sp"
            android:textColor="@android:color/black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="ইমেইল"
            android:fontFamily="@font/kalpurush"/>

        <TextView
            android:textSize="14sp"
            android:textColor="@android:color/darker_gray"
            android:id="@+id/email"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="contact@clinic.com idk"
            android:fontFamily="@font/kalpurush"/>

        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="অতিরিক্ত তথ্য"
            android:fontFamily="@font/kalpurush"/>

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <Button
                android:textColor="@android:color/white"
                android:id="@+id/complain"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="অভিযোগ"
                android:layout_weight="1"
                android:textAllCaps="false"
                android:fontFamily="@font/kalpurush"
                android:backgroundTint="#1eb1b1"
                android:paddingHorizontal="16dp"
                android:paddingVertical="10dp"
                app:cornerRadius="8dp"/>

            <View
                android:layout_width="8dp"
                android:layout_height="wrap_content"/>

            <Button
                android:textColor="@android:color/black"
                android:id="@+id/serial"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="সিরিয়াল নম্বর"
                android:layout_weight="1"
                android:fontFamily="@font/kalpurush"
                android:backgroundTint="#dcd4d4"
                app:cornerRadius="8dp"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>