<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <androidx.cardview.widget.CardView
        android:id="@+id/donor_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:layout_marginHorizontal="4dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp">
        <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/bgdg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <!-- Donor Image -->
            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/donor_image"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginEnd="12dp"
                android:contentDescription="Donor Photo"
                android:src="@drawable/blood_donar"
                app:civ_border_color="@android:color/black"
                app:civ_border_width="1dp" />

            <!-- Donor Information -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Donor Name -->
                <TextView
                    android:id="@+id/donor_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/siligurimedium"
                    android:paddingBottom="4dp"
                    android:text="ডোনারের নাম"
                    android:textColor="@android:color/black"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- Blood Group (highlighted in red) -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="রক্ত:"
                        android:textColor="@android:color/black"
                        android:textSize="13sp"
                        android:fontFamily="@font/siligurimedium" />

                    <TextView
                        android:id="@+id/blood_group"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:fontFamily="@font/siligurimedium"
                        android:text="O+"
                        android:textColor="#d32f2f"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Donor Address -->
                <TextView
                    android:id="@+id/donor_address"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/siligurimedium"
                    android:text="ঠিকানা"
                    android:textColor="@android:color/black"
                    android:textSize="13sp"
                    android:layout_marginTop="4dp" />

                <!-- Donor Phone -->
                <TextView
                    android:id="@+id/donor_phone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ফোন: "
                    android:textColor="@android:color/black"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/siligurimedium"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- Action Buttons -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:layout_marginStart="8dp">

                <!-- Call Button -->
                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/lottie_call"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:contentDescription="Call Animation"
                    app:lottie_autoPlay="true"
                    app:lottie_loop="true"
                    app:lottie_rawRes="@raw/call" />

                <TextView
                    android:id="@+id/text_call"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/siligurimedium"
                    android:text="কল"
                    android:textColor="@android:color/black"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/bottom_row"
            android:visibility="gone"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Edit Button -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_edit"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="✎  সম্পাদনা করুন"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_edit_bg"
                android:fontFamily="@font/kalpurush"
                android:contentDescription="Edit"/>

            <!-- Delete Button -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_delete"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="🗑  মুছে দিন"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_delete_bg"
                android:fontFamily="@font/kalpurush"
                android:contentDescription="Delete"/>
        </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>
