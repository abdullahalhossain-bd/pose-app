<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#f5f5f5">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/colorPrimary"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        android:elevation="4dp"/>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="16dp"
        android:visibility="gone"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Main Notice Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Notice Type Badge -->
                    <TextView
                        android:id="@+id/typeText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="গুরুত্বপূর্ণ"
                        android:textSize="12sp"
                        android:textColor="#fff"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:background="@drawable/notice_type_important"
                        android:layout_marginBottom="8dp"
                        android:visibility="visible"
                        android:fontFamily="@font/bnlatxf" />

                    <!-- Notice Title -->
                    <TextView
                        android:id="@+id/titleText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="নোটিশের শিরোনাম"
                        android:textSize="20sp"
                        android:textColor="#000"
                        android:textStyle="bold"
                        android:fontFamily="@font/kalpurush"
                        android:layout_marginBottom="8dp"/>

                    <!-- Notice Date -->
                    <TextView
                        android:id="@+id/dateText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="২৫ জানুয়ারি, ২০২৪"
                        android:textSize="14sp"
                        android:textColor="#666"
                        android:fontFamily="@font/kalpurush"
                        android:layout_marginBottom="8dp"/>

                    <!-- Department -->
                    <TextView
                        android:id="@+id/departmentText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="উপজেলা প্রশাসন"
                        android:textSize="14sp"
                        android:textColor="#666"
                        android:fontFamily="@font/kalpurush"
                        android:layout_marginBottom="16dp"
                        android:visibility="visible"/>

                    <!-- Notice Image -->
                    <ImageView
                        android:id="@+id/noticeImage"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:scaleType="centerCrop"
                        android:contentDescription="Notice image"
                        android:layout_marginBottom="16dp"
                        android:visibility="gone"/>

                    <!-- Notice Description -->
                    <TextView
                        android:id="@+id/descriptionText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="নোটিশের বিস্তারিত বিবরণ..."
                        android:textSize="16sp"
                        android:textColor="#333"
                        android:lineSpacingExtra="4dp"
                        android:fontFamily="@font/kalpurush"/>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Attachment Container -->
            <androidx.cardview.widget.CardView
                android:id="@+id/attachmentContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="16dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Attachment Header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_file"
                            android:tint="@color/colorPrimary"
                            android:contentDescription="Attachments"/>

                        <TextView
                            android:id="@+id/attachmentCountText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="সংযুক্তি (0)"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#000"
                            android:fontFamily="@font/kalpurush"
                            android:layout_marginStart="8dp"/>

                    </LinearLayout>

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E0E0E0"
                        android:layout_marginBottom="8dp"/>

                    <!-- Attachment List Container -->
                    <LinearLayout
                        android:id="@+id/attachmentListContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"/>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- RecyclerView (kept for compatibility, hidden) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/attachmentRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:nestedScrollingEnabled="false"/>

            <!-- Empty State -->
            <LinearLayout
                android:id="@+id/emptyStateLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="32dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@drawable/ic_file"
                    android:tint="#CCCCCC"
                    android:contentDescription="No data"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="কোন তথ্য পাওয়া যায়নি"
                    android:textSize="16sp"
                    android:textColor="#999"
                    android:fontFamily="@font/kalpurush"
                    android:gravity="center"/>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>