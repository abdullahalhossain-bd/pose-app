<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/titleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="8dp"
            android:text="তথ্য যাচাই করুন"
            android:textColor="#111111"
            android:textSize="20sp"
            android:textStyle="bold" android:fontFamily="@font/bnlatxf" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            app:cardUseCompatPadding="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="4dp"
                    android:text="অনুগ্রহ করে নিচের তথ্যগুলো ভালোভাবে যাচাই করুন। সবকিছু সঠিক হলে সাবমিট বাটনে চাপ দিন।"
                    android:textColor="#222222"
                    android:textSize="15sp" android:fontFamily="@font/bnlatxf" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="ধরণ"
                    android:textColor="#666666"
                    android:textSize="13sp"
                    android:textStyle="bold" android:fontFamily="@font/bnlatxf" />
                <TextView
                    android:id="@+id/valueType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#111111"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="শিরোনাম"
                    android:textColor="#666666"
                    android:textSize="13sp"
                    android:textStyle="bold" android:fontFamily="@font/bnlatxf" />
                <TextView
                    android:id="@+id/valueTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#111111"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="বিস্তারিত / বর্ণনা"
                    android:textColor="#666666"
                    android:textSize="13sp"
                    android:textStyle="bold" android:fontFamily="@font/bnlatxf" />
                <TextView
                    android:id="@+id/valueDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#111111"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="অবস্থান"
                    android:textColor="#666666"
                    android:textSize="13sp"
                    android:textStyle="bold" android:fontFamily="@font/bnlatxf" />
                <TextView
                    android:id="@+id/valueLocation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#111111"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="বিভাগ"
                    android:textColor="#666666"
                    android:textSize="13sp"
                    android:textStyle="bold" android:fontFamily="@font/bnlatxf" />
                <TextView
                    android:id="@+id/valueDepartment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#111111"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="অগ্রাধিকার"
                    android:textColor="#666666"
                    android:textSize="13sp"
                    android:textStyle="bold" android:fontFamily="@font/bnlatxf" />
                <TextView
                    android:id="@+id/valuePriority"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#111111"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="যোগাযোগ নম্বর"
                    android:textColor="#666666"
                    android:textSize="13sp"
                    android:textStyle="bold" android:fontFamily="@font/bnlatxf" />
                <TextView
                    android:id="@+id/valueContact"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#111111"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="ইমেইল"
                    android:textColor="#666666"
                    android:textSize="13sp"
                    android:textStyle="bold" android:fontFamily="@font/bnlatxf" />
                <TextView
                    android:id="@+id/valueEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#111111"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="অভিযোগকারীর নাম"
                    android:textColor="#666666"
                    android:textSize="13sp"
                    android:textStyle="bold" android:fontFamily="@font/bnlatxf" />
                <TextView
                    android:id="@+id/valueName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#111111"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="তারিখ"
                    android:textColor="#666666"
                    android:textSize="13sp"
                    android:textStyle="bold" android:fontFamily="@font/bnlatxf" />
                <TextView
                    android:id="@+id/valueDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#111111"
                    android:textSize="15sp" />

                <ImageView
                    android:id="@+id/attachedImage"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:layout_marginTop="12dp"
                    android:contentDescription="সংযুক্ত ছবি"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone" />

        <androidx.cardview.widget.CardView
            android:id="@+id/confirmSubmitButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="#4CAF50"
            app:cardCornerRadius="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="16dp"
                android:text="সাবমিট করুন"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold" android:fontFamily="@font/bnlatxf" />
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/editBackButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardBackgroundColor="#FF9800"
            app:cardCornerRadius="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="16dp"
                android:text="পরিবর্তন করুন"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold" android:fontFamily="@font/bnlatxf" />
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
