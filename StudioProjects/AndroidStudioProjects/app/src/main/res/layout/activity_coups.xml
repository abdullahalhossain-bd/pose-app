                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:fontFamily="@font/kalpurush"
                    android:text="জেনারেল এরশাদের পতনের পরে ১৯৯১ সালে বাংলাদেশে একটি অবাধ সাধারণ নির্বাচনের পর গণতান্ত্রিক ব্যবস্থা পুনরায় চালু হয়।  এরপর বাংলাদেশে আরো তিনটি সাধারণ নির্বাচন অনুষ্ঠিত হয়েছে।  অবশ্য ১৯৯৬ সালের ১৫ ফেব্রুয়ারি প্রধান বিরোধী দলগুলোর বর্জনের মুখে বিতর্কিত একটি নির্বাচন অনুষ্ঠিত হয়েছিল।"
                    android:textColor="#666666"
