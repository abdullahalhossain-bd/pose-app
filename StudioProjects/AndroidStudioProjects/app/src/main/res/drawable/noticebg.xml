<?xml version="1.0" encoding="utf-8"?>
<!-- res/drawable/square_stroke_background.xml -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <!-- Corner radius -->
    <corners android:radius="7dp" />

    <!-- Stroke settings -->
    <stroke
        android:width="2dp"
        android:color="#FF0000" /> <!-- Red color for the stroke -->

    <!-- Background color (optional, set it to transparent if not needed) -->
    <solid android:color="#FFFFFF" /> <!-- White background -->
</shape>
