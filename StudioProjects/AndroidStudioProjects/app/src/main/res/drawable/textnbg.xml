<?xml version="1.0" encoding="utf-8"?>
<!-- res/drawable/square_stroke_background.xml -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <!-- Corner radius -->
    <corners android:topLeftRadius="8dp"
        android:bottomLeftRadius="8dp"
        />

    <!-- Stroke settings -->
    <stroke
        android:width="1dp"
        android:color="#FF0000" /> <!-- Red color for the stroke -->

    <!-- Background color (optional, set it to transparent if not needed) -->
    <solid android:color="@color/bar" /> <!-- White background -->
</shape>
